# Neon development branch. This is not the laptop default.
# Zero-config local SQLite uses APP_ENV=local and an empty DATABASE_URL (.env.example).
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@ep-development.region.aws.neon.tech/neondb?sslmode=require
HF_TOKEN=
SUMMARY_PROVIDER=local
LOCAL_SUMMARY_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GITHUB_TOKEN=
REVALIDATE_SECRET=dev-revalidate-secret
WEB_REVALIDATE_URL=http://127.0.0.1:43123/api/revalidate
ENRICH=
NEON_PROJECT_ID=proj_placeholder
NEON_BRANCH=development
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
