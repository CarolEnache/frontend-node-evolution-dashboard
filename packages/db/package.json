{
  "name": "@evolution/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts",
    "generate:postgres": "drizzle-kit generate --config drizzle.config.postgres.ts",
    "migrate": "tsx src/cli.ts migrate",
    "migrate:sqlite": "tsx src/cli.ts migrate --dialect sqlite",
    "migrate:postgres": "tsx src/cli.ts migrate --dialect postgres",
    "seed": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "@evolution/shared-types": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}
