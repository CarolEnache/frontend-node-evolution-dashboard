# Copy to .env.local (web) or .env (worker). Never commit real values.
# Per-environment templates: .env.development.example, .env.integration.example,
# .env.staging.example, .env.production.example.

APP_ENV=development

# Unset uses <repo>/data/dev.sqlite regardless of the process cwd.
# SQLite when unset: <repo>/data/dev.sqlite.
# Non-local Postgres is Neon Free: one project, branches
# development, integration, staging, production. Placeholders only.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional. Used only when SUMMARY_PROVIDER=huggingface.
HF_TOKEN=

# local (default) | cloudflare | huggingface
# local model: onnx-community/Llama-3.2-1B-Instruct-ONNX
# lighter local model: LOCAL_SUMMARY_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
# or LOCAL_SUMMARY_MODEL=light
SUMMARY_PROVIDER=local
LOCAL_SUMMARY_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Public GitHub data works unauthenticated at 60 requests/hour.
# Conditional 304 responses do not count against the quota.
GITHUB_TOKEN=

# In-process scheduler, whole hours from 1 to 24.
# Fast group: MDN, Can I Use, Node.js (default 6).
# Slow group: TypeScript, Next.js (default 12).
# INGEST_INTERVAL_HOURS sets one interval for every source and overrides the two groups.
INGEST_FAST_HOURS=
INGEST_SLOW_HOURS=
INGEST_INTERVAL_HOURS=

# Per-request timeout and retries for upstream fetches. Defaults: 20000 ms, 3 attempts.
# Retryable statuses are 408, 429, 500, 502, 503, and 504, plus timeouts and network errors.
FETCH_TIMEOUT_MS=
FETCH_MAX_ATTEMPTS=

# Shared by the worker and POST /api/revalidate.
REVALIDATE_SECRET=replace-me
WEB_REVALIDATE_URL=http://127.0.0.1:43123/api/revalidate

# Set to 1 to embed, classify, and summarise during ingest.
# Local bge embeddings download Xenova/bge-small-en-v1.5 on first use.
ENRICH=

# Neon / Vercel placeholders. Do not create projects from this repo.
NEON_PROJECT_ID=
NEON_BRANCH=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
